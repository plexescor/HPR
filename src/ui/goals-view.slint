import { Card } from "./card.slint";
import { SectionHeader } from "./section-header.slint";
import { AppGoalData } from "./types.slint";
import { LineEdit } from "std-widgets.slint";


export component GoalsView {
    in property <[AppGoalData]> raw-apps;

    callback set-limit(string, int);
    callback set-goal(string, int);

    // Keep track of which row is currently being configured
    property <int> active-edit-index: -1;
    property <int> input-minutes: 30;

    VerticalLayout {
        padding: 12px;
        padding-top: 0px;
        spacing: 10px;

        SectionHeader { label: "MANAGE APP LIMITS & GOALS"; }

        Card {
            vertical-stretch: 1;
            Flickable {
                width: 100%;
                height: 100%;
                interactive: true;
                viewport-height: appContent.preferred-height;

                appContent := VerticalLayout {
                    width: 100%;
                    padding-bottom: 20px;
                    
                    if raw-apps.length == 0 : Rectangle {
                        height: 100px;
                        Text {
                            text: "NO RAW APPS TRACKED YET";
                            color: #ffffff40;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 2px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    for app-goal-data[i] in raw-apps : Rectangle {
                        height: active-edit-index == i ? 98px : 48px;
                        border-radius: 5px;
                        clip: true;
                        background: ta.has-hover ? #ffffff0e : (mod(i, 2) == 0 ? #ffffff03 : transparent);

                        animate height { duration: 180ms; easing: ease-in-out; }
                        animate background { duration: 100ms; easing: ease-out; }

                        ta := TouchArea {
                            pointer-event(evt) => {
                                if (evt.kind == PointerEventKind.down) {
                                    // Toggle edit mode on right-click or click
                                    if (active-edit-index == i) {
                                        active-edit-index = -1;
                                    } else {
                                        active-edit-index = i;
                                        input-minutes = 30; // reset to default
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 8px;

                            // Top row showing the App Name and current state indication
                            HorizontalLayout {
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: app-goal-data.name;
                                        color: ta.has-hover ? #e2e8f0 : #94a3b8;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        animate color { duration: 100ms; }
                                        overflow: elide;
                                    }

                                    if app-goal-data.limit_mins > 0 : Rectangle {
                                        background: #ef444420;
                                        border-color: #ef444450;
                                        border-width: 1px;
                                        border-radius: 3px;
                                        height: 16px;
                                        width: limit-text.preferred-width + 8px;
                                        y: (parent.height - self.height) / 2;

                                        limit-text := Text {
                                            text: "Limit: " + app-goal-data.limit_mins + "m" + (app-goal-data.limit_remaining != "" ? " (" + app-goal-data.limit_remaining + " left)" : "");
                                            color: #ef4444;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if app-goal-data.goal_mins > 0 : Rectangle {
                                        background: #10b98120;
                                        border-color: #10b98150;
                                        border-width: 1px;
                                        border-radius: 3px;
                                        height: 16px;
                                        width: goal-text.preferred-width + 8px;
                                        y: (parent.height - self.height) / 2;

                                        goal-text := Text {
                                            text: "Goal: " + app-goal-data.goal_mins + "m" + (app-goal-data.goal_remaining != "" ? " (" + app-goal-data.goal_remaining + " left)" : "");
                                            color: #10b981;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if active-edit-index != i : Text {
                                    text: "Configure (Click)";
                                    color: #ffffff20;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }

                            // Expanded section for settings
                            if active-edit-index == i : HorizontalLayout {

                                alignment: space-between;
                                spacing: 12px;

                                // Minutes adjustment layout
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    Text {
                                        text: "Minutes:";
                                        color: #94a3b8;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }

                                    // Minus button
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: ta-minus.has-hover ? #ffffff15 : #ffffff08;
                                        border-width: 1px;
                                        border-color: #ffffff10;

                                        ta-minus := TouchArea {
                                            clicked => {
                                                if (input-minutes > 5) {
                                                    input-minutes -= 5;
                                                }
                                            }
                                        }

                                        Text {
                                            text: "-";
                                            color: #e2e8f0;
                                            font-size: 14px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    LineEdit {
                                        width: 72px;
                                        height: 26px;
                                        text: input-minutes;
                                        edited(text) => {
                                            input-minutes = text.to-float();
                                        }
                                    }


                                    // Plus button
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: ta-plus.has-hover ? #ffffff15 : #ffffff08;
                                        border-width: 1px;
                                        border-color: #ffffff10;

                                        ta-plus := TouchArea {
                                            clicked => {
                                                input-minutes += 5;
                                            }
                                        }

                                        Text {
                                            text: "+";
                                            color: #e2e8f0;
                                            font-size: 14px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Set Limit / Set Goal buttons
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;

                                    // Reset Button
                                    Rectangle {
                                        width: 82px;
                                        height: 26px;
                                        border-radius: 5px;
                                        background: ta-reset.pressed ? #e2e8f045 : (ta-reset.has-hover ? #e2e8f025 : #e2e8f012);
                                        border-width: 1px;
                                        border-color: ta-reset.has-hover ? #e2e8f060 : #e2e8f035;

                                        ta-reset := TouchArea {
                                            clicked => {
                                                root.set-limit(app-goal-data.name, 0);
                                                root.set-goal(app-goal-data.name, 0);
                                                active-edit-index = -1;
                                            }
                                        }

                                        Text {
                                            text: "RESET";
                                            color: ta-reset.has-hover ? #ffffff : #94a3b8;
                                            font-size: 9px;
                                            font-weight: 700;
                                            letter-spacing: 1px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Limit Button
                                    Rectangle {
                                        width: 82px;
                                        height: 26px;
                                        border-radius: 5px;
                                        background: ta-limit.pressed ? #ef444445 : (ta-limit.has-hover ? #ef444425 : #ef444412);
                                        border-width: 1px;
                                        border-color: ta-limit.has-hover ? #ef444460 : #ef444435;

                                        ta-limit := TouchArea {
                                            clicked => {
                                                root.set-limit(app-goal-data.name, input-minutes);
                                                active-edit-index = -1;
                                            }
                                        }

                                        Text {
                                            text: "SET LIMIT";
                                            color: ta-limit.has-hover ? #f87171 : #ef4444;
                                            font-size: 9px;
                                            font-weight: 700;
                                            letter-spacing: 1px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Goal Button
                                    Rectangle {
                                        width: 82px;
                                        height: 26px;
                                        border-radius: 5px;
                                        background: ta-goal.pressed ? #10b98145 : (ta-goal.has-hover ? #10b98125 : #10b98112);
                                        border-width: 1px;
                                        border-color: ta-goal.has-hover ? #10b98160 : #10b98135;

                                        ta-goal := TouchArea {
                                            clicked => {
                                                root.set-goal(app-goal-data.name, input-minutes);
                                                active-edit-index = -1;
                                            }
                                        }

                                        Text {
                                            text: "SET GOAL";
                                            color: ta-goal.has-hover ? #34d399 : #10b981;
                                            font-size: 9px;
                                            font-weight: 700;
                                            letter-spacing: 1px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
