import { Card } from "./card.slint";
import { SectionHeader } from "./section-header.slint";
import { Palette } from "./palette.slint";

export struct LoadedExtension_S {
    author-name: string,
    extension-name: string,
    is-compatible: bool,
    compatibility-warning: string,
}

export component ExtensionsView {
    in property <[LoadedExtension_S]> loadedExtensions_S;

    callback refresh-extensions();
    callback disable-extension(string, string);
    callback reload-extension(string, string);
    callback action-extension(string, string);
    callback open-hpr-store();

    VerticalLayout {
        padding: 12px * Palette.scale;
        padding-top: 6px * Palette.scale;
        spacing: 10px * Palette.scale;

        HorizontalLayout {
            alignment: space-between;
            vertical-stretch: 0;
            padding-top: 4px * Palette.scale;

            SectionHeader { label: "EXTENSIONS"; }

            refreshBtn := Rectangle {
                width: 72px * Palette.scale;
                height: 26px * Palette.scale;
                border-radius: 6px * Palette.scale;
                border-width: 1px * Palette.scale;

                animate background { duration: 100ms; }
                animate border-color { duration: 100ms; }

                ta-refresh := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.refresh-extensions(); }
                }

                states [
                    pressed when ta-refresh.pressed: {
                        background: #34d39935;
                        border-color: #34d39980;
                    }
                    hovered when ta-refresh.has-hover: {
                        background: #34d39925;
                        border-color: #34d39960;
                    }
                    normal when !ta-refresh.has-hover: {
                        background: #34d39912;
                        border-color: #34d39935;
                    }
                ]

                Text {
                    //thing is refresh seemed liek refreshing the page
                    //but its not so i renamed to rescan which is more accurate
                    //though all the code still treats as "REFRSH" button for refrencing functions
                    //and i didnt want to do any refactors
                    text: "RESCAN";
                    font-size: 8px * Palette.scale;
                    font-weight: 700;
                    letter-spacing: 2px * Palette.scale;
                    color: ta-refresh.pressed ? #a7f3d0 : ta-refresh.has-hover ? #6ee7b7 : #34d399;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: 100ms; }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            interactive: true;
            viewport-height: extContent.preferred-height;

            extContent := VerticalLayout {
                width: 100%;
                spacing: 8px * Palette.scale;

                if loadedExtensions_S.length == 0 : Card {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px * Palette.scale;
                        spacing: 16px * Palette.scale;
                        alignment: center;

                        Text {
                            text: "NO EXTENSIONS LOADED";
                            font-size: 11px * Palette.scale;
                            font-weight: 700;
                            letter-spacing: 2.5px * Palette.scale;
                            color: Palette.text-muted;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Discover and install community extensions to extend HPR's capabilities.";
                            font-size: 12px * Palette.scale;
                            color: Palette.text-secondary;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: center;
                            storeBtn := Rectangle {
                                width: storeBtnText.preferred-width + 36px * Palette.scale;
                                height: 38px * Palette.scale;
                                border-radius: 8px * Palette.scale;
                                border-width: 1px * Palette.scale;
                                border-color: ta-store.pressed ? #a855f7 : (ta-store.has-hover ? #c084fc : #a855f780);
                                background: ta-store.pressed ? #a855f735 : (ta-store.has-hover ? #a855f725 : #a855f715);
                                animate background { duration: 100ms; }
                                animate border-color { duration: 100ms; }

                                ta-store := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-hpr-store(); }
                                }

                                storeBtnText := Text {
                                    text: "GET HPR-STORE FOR EXTENSIONS";
                                    font-size: 11px * Palette.scale;
                                    font-weight: 700;
                                    letter-spacing: 1.5px * Palette.scale;
                                    color: ta-store.pressed ? #e9d5ff : (ta-store.has-hover ? #f3e8ff : #c084fc);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    animate color { duration: 100ms; }
                                }
                            }
                        }
                    }
                }

                for ext in loadedExtensions_S : Card {
                    height: 86px * Palette.scale;

                    HorizontalLayout {
                        padding: 14px * Palette.scale;
                        spacing: 12px * Palette.scale;
                        alignment: space-between;

                        VerticalLayout {
                            alignment: space-between;
                            vertical-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px * Palette.scale;

                                Text {
                                    text: ext.author-name;
                                    font-size: 12.5px * Palette.scale;
                                    font-weight: 700;
                                    letter-spacing: 1.5px * Palette.scale;
                                    color: #c084fc;
                                }

                                if !ext.is-compatible : Text {
                                    text: ext.compatibility-warning;
                                    font-size: 11px * Palette.scale;
                                    font-weight: 600;
                                    color: #facc15;
                                    wrap: word-wrap;
                                }
                            }

                            Text {
                                text: ext.extension-name;
                                font-size: 14.82px * Palette.scale;
                                font-weight: 600;
                                color: #a3e635;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 5px * Palette.scale;

                            actionBtn := Rectangle {
                                width: 138px * Palette.scale;
                                height: 24px * Palette.scale;
                                border-radius: 6px * Palette.scale;
                                border-width: 1px * Palette.scale;

                                animate background { duration: 100ms; }
                                animate border-color { duration: 100ms; }

                                ta-action := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.action-extension(ext.author-name, ext.extension-name); }
                                }

                                states [
                                    pressed when ta-action.pressed: {
                                        background: #facc1535;
                                        border-color: #facc1580;
                                    }
                                    hovered when ta-action.has-hover: {
                                        background: #facc1525;
                                        border-color: #facc1560;
                                    }
                                    normal when !ta-action.has-hover: {
                                        background: #facc1512;
                                        border-color: #facc1535;
                                    }
                                ]

                                Text {
                                    text: "ACTION";
                                    font-size: 8px * Palette.scale;
                                    font-weight: 700;
                                    letter-spacing: 1.5px * Palette.scale;
                                    color: ta-action.pressed ? #fef08a : ta-action.has-hover ? #fde047 : #facc15;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    animate color { duration: 100ms; }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px * Palette.scale;

                                disableBtn := Rectangle {
                                    width: 66px * Palette.scale;
                                    height: 28px * Palette.scale;
                                    border-radius: 6px * Palette.scale;
                                    border-width: 1px * Palette.scale;

                                    animate background { duration: 100ms; }
                                    animate border-color { duration: 100ms; }

                                    ta-disable := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.disable-extension(ext.author-name, ext.extension-name); }
                                    }

                                    states [
                                        pressed when ta-disable.pressed: {
                                            background: #ff605c35;
                                            border-color: #ff605c80;
                                        }
                                        hovered when ta-disable.has-hover: {
                                            background: #ff605c25;
                                            border-color: #ff605c60;
                                        }
                                        normal when !ta-disable.has-hover: {
                                            background: #ff605c12;
                                            border-color: #ff605c35;
                                        }
                                    ]

                                    Text {
                                        text: "DISABLE";
                                        font-size: 8px * Palette.scale;
                                        font-weight: 700;
                                        letter-spacing: 1.5px * Palette.scale;
                                        color: ta-disable.pressed ? #ff8582 : ta-disable.has-hover ? #ff7572 : #ff605c;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        animate color { duration: 100ms; }
                                    }
                                }

                                reloadBtn := Rectangle {
                                    width: 66px * Palette.scale;
                                    height: 28px * Palette.scale;
                                    border-radius: 6px * Palette.scale;
                                    border-width: 1px * Palette.scale;

                                    animate background { duration: 100ms; }
                                    animate border-color { duration: 100ms; }

                                    ta-reload := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.reload-extension(ext.author-name, ext.extension-name); }
                                    }

                                    states [
                                        pressed when ta-reload.pressed: {
                                            background: #38bdf835;
                                            border-color: #38bdf880;
                                        }
                                        hovered when ta-reload.has-hover: {
                                            background: #38bdf825;
                                            border-color: #38bdf860;
                                        }
                                        normal when !ta-reload.has-hover: {
                                            background: #38bdf812;
                                            border-color: #38bdf835;
                                        }
                                    ]

                                    Text {
                                        text: "RELOAD";
                                        font-size: 8px * Palette.scale;
                                        font-weight: 700;
                                        letter-spacing: 1.5px * Palette.scale;
                                        color: ta-reload.pressed ? #7dd8fb : ta-reload.has-hover ? #5dcffa : #38bdf8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        animate color { duration: 100ms; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}