import { ListView, Button, DatePickerPopup} from "std-widgets.slint";

import { LiveDot } from "./live-dot.slint";
import { Card } from "./card.slint";
import { SidebarButton } from "./side-bar-button.slint";
import { SectionHeader } from "./section-header.slint";
import { AppRow } from "./app-row.slint";
import { SwitchRow } from "./switch-row.slint";

export struct TimeLog {
    name: string,
    duration: string,
    duration_i: int,
}

export struct SwitchHistory {
    fromWindow: string,
    toWindow: string,
    maxTimeStamp: string,
}

// ── Main Window ──────────────────────────────────────────────────────────────
export component MainWindow inherits Window {
    icon: @image-url("../../assets/logo_256png.png");
    
    callback loadHistoricalData_Singular(string);
    callback loadLiveData;

    in property <int>             trackedTime_S;
    in property <string>          windowName_S;
    in property <[TimeLog]>       timePerApp_S;
    in property <[SwitchHistory]> switchHistory_S;

    title: "HPR";
    default-font-size: 13px;
    background: #07090f;
    preferred-width: 780px;
    preferred-height: 600px;

    property <[color]> bar-palette: [
        #a3e635,
        #38bdf8,
        #f472b6,
        #fb923c,
        #c084fc,
        #34d399,
        #facc15,
        #f87171,
    ];

    date-picker := DatePickerPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: PopupClosePolicy.no-auto-close;
        accepted(date) => {
            //Convert to this format: DD-MM-YY
            root.loadHistoricalData_Singular(
                (date.day < 10 ? "0" : "") + date.day + "-" +
                (date.month < 10 ? "0" : "") + date.month + "-" +
                (Math.mod(date.year, 100) < 10 ? "0" : "") + Math.mod(date.year, 100)
            );
            date-picker.close();
        }
        canceled => { date-picker.close(); }
    }

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;
        width: 100%;
        height: 100%;

        // ── Left Sidebar ─────────────────────────────────────────────────
        // z:1 makes the whole sidebar paint above the main content column
        sidebar-ta := TouchArea {
            z: 1;
            width: sidebar-ta.has-hover ? 54px : 12px;
            animate width { duration: 180ms; easing: ease-in-out; }

            Rectangle {
                x: 0px;
                width: 100%;
                height: 100%;

                background: sidebar-ta.has-hover ? #0d1117 : transparent;
                animate background { duration: 240ms; easing: ease-in-out; }

                // Right border
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: sidebar-ta.has-hover ? #ffffff08 : transparent;
                    animate background { duration: 240ms; easing: ease-in-out; }
                }

                // Collapsed: just the ">" arrow tab
                Rectangle {
                    visible: !sidebar-ta.has-hover;
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 28px;
                    border-radius: 4.5px;
                    background: #ffffff07;
                    border-width: 1px;
                    border-color: #ffffff10;

                    Text {
                        text: "›";
                        color: #ffffff40;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                // Expanded: buttons
                VerticalLayout {
                    visible: sidebar-ta.has-hover;
                    padding: 2px;
                    spacing: 8px;
                    alignment: center;
                    width: 75%;
                    height: 100%;

                    SidebarButton {
                        icon: "🕘";
                        tip: "View historical data";
                        clicked => { date-picker.show(); }
                    }

                    SidebarButton {
                        icon: "⚡";
                        tip: "Switch to live view";
                        clicked => { root.loadLiveData(); }
                    }
                }
            }
        }

        // ── Main content (topbar + body) ──────────────────────────────────
        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            horizontal-stretch: 1;

            // ── Topbar ───────────────────────────────────────────────────────
            Rectangle {
                height: 46px;
                background: #07090f;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: @linear-gradient(90deg, #ffffff00 0%, #ffffff12 40%, #ffffff12 60%, #ffffff00 100%);
                }

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "HPR";
                            color: #f1f5f9;
                            font-size: 12px;
                            font-weight: 700;
                            letter-spacing: 4px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 1px;
                            height: 12px;
                            background: #ffffff12;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "Human Pattern Recorder";
                            color: #ffffff40;
                            font-size: 11px;
                            letter-spacing: 0.3px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 26px;
                        width: active-lbl.preferred-width + 30px;
                        border-radius: 13px;
                        background: #ffffff07;
                        border-width: 1px;
                        border-color: #ffffff10;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 9px;
                            spacing: 6px;
                            alignment: start;

                            LiveDot {
                                y: (parent.height - self.height) / 2;
                                is-alert: windowName_S.character-count > 84;
                            }

                            active-lbl := Text {
                                text: windowName_S;
                                color: #94a3b8;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                                max-width: 550px;
                            }
                        }
                    }
                }
            }

            // ── Body ─────────────────────────────────────────────────────
            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                SectionHeader { label: "TIME PER APP"; }

                Card {
                    Flickable {
                        width: 100%;
                        height: 100%;
                        interactive: true;
                        viewport-height: appContent.preferred-height;

                        appContent := VerticalLayout {
                            width: 100%;
                            for entry[i] in timePerApp_S: AppRow {
                                app-name: entry.name;
                                ratio: trackedTime_S > 0 ? (entry.duration_i * 1.0) / (trackedTime_S * 1.0) : 0.0;
                                duration: entry.duration + " (" + Math.round(self.ratio * 100) + "%" + ")";
                                is-even: mod(i, 2) == 0;
                                row-index: i;
                                bar-color: Colors.hsv(mod(entry.name.character-count * 47, 360), 0.75, 0.85);
                            }
                        }
                    }
                }

                SectionHeader { label: "SWITCH HISTORY"; }

                Card {
                    vertical-stretch: 1;

                    Flickable {
                        width: 100%;
                        height: 100%;
                        interactive: true;
                        viewport-height: swContent.preferred-height;

                        swContent := VerticalLayout {
                            width: 100%;
                            for entry[i] in switchHistory_S: SwitchRow {
                                from-window: entry.fromWindow;
                                to-window:   entry.toWindow;
                                timestamp:   entry.maxTimeStamp;
                                is-even: mod(i, 2) == 0;
                            }
                        }
                    }
                }
            }
        }
    }
}